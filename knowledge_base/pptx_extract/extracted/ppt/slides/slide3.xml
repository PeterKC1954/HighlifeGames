icrosoft.com/office/drawing/2014/main" id="{4F939CF9-E49F-6CD4-9517-C21938C0CEA9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="463061" y="710948"/><a:ext cx="11265877" cy="5109091"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="FFFF00"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:rPr><a:t>Action 1) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:rPr><a:t>If landing player lands on a Company Account square that has not been issued. The Highlife Server will present landing player with advert of the company that has sponsored the square, (it will stay on display for 10 seconds with message “click screen to attempt question to gain this account use of a Boffins not allowed). All other players will see sponsor advert whilst landing player is in play. They may use time to check their own Game Account Folder.</a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:rPr><a:t> </a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="00FFFF"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:rPr><a:t>Action 1a) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:rPr><a:t>If player does not click in the 10 seconds, go ends and passes to next player in turn. All other players will see sponsor advert whilst landing players move is active. They may use time to check their own Game Account Folder.</a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> </a:t></a:r></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="FFFF00"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Action 1b)</a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> Player on clicking screen, that colour banded Company Square Dice will role and display value of HECUs for question for player. </a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> </a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="FFFF00"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Action 1c)</a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> Then they will get sponsored question on screen for 20 seconds, which will be read only to them. All other players will be presented with sponsor’s advert, whilst landing players move is active. In this time other players can choose to select to check own Game Account Folder contents.</a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> </a:t></a:r></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="FFFF00"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Action 1d) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Landing players screen after 20 seconds will change to display 4 options to answer the question with timer counting down from 20 to zero in seconds. Player must select one answer in the 20 seconds. Or go ends and passes to next player in turn.</a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> </a:t></a:r></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="FFFF00"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Action 2a) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>If player selects the correct answer in the time. Their Game Folder will be credited with that Company Account, plus 1 Team Worker will be deposited on the Company Square for them, plus they will have credited to their Game Account the </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>value of HECUs </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>reward for question as reward, for each Team Worker they have on that Company Account. Then their go ends and play moves to next player in turn.</a:t></a:r></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="00FFFF"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Action 2b) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>If player selects wrong answer, message appears on all player screens player gave wrong answer and their go ends and play moves to next player in turn.</a:t></a:r><a:endParaRPr lang="en-GB" sz="1400" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="915402971"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>