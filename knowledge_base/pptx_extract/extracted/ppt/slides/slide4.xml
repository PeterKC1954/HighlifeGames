mas.microsoft.com/office/drawing/2014/main" id="{ABC87CA2-6248-A05D-6D70-D7E65633801F}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="-3892062" y="6629400"/><a:ext cx="11019692" cy="2092881"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:endParaRPr lang="en-GB" sz="1400" i="1" dirty="0"><a:solidFill><a:srgbClr val="002060"/></a:solidFill></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>Action 6) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>Player is not allowed to use Boffins to answer Consultation Questions.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" i="1" dirty="0"><a:solidFill><a:srgbClr val="002060"/></a:solidFill></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>if Game Server finds they have, then displayed on screen at same time  player will see displayed any Boffins that they have in their Game Folder that they could used to help answer the question. With message you have 10 seconds to click one to help you. Using boffins will reduce value of reward to question. Clicking on Boffin will activate relative  level of help. If player clicks a Boffin it will be taken from the screen , then the player then has another 10 seconds to answer question. Then </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>(Action 4</a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>) Comes into play. If player selects wrong answer (Action 4a) Comes into play.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="7" name="TextBox 6"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{EFC3F473-B38B-D758-11AF-F318BC21A1B5}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="1699847" y="720915"/><a:ext cx="7432430" cy="523220"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>Action 1) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" i="1" dirty="0"><a:solidFill><a:srgbClr val="002060"/></a:solidFill></a:rPr><a:t>Highlife Server will check which player has control of the Company Account.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" i="1" dirty="0"><a:solidFill><a:srgbClr val="002060"/></a:solidFill></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="8" name="TextBox 7"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{22593885-31BC-3CFD-D83F-3568768C750E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="855784" y="1137139"/><a:ext cx="10421815" cy="5047536"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>Action 3) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>If Highlife Server finds Company Account is issued to landing player. The Highlife Server will present landing player with advert of the company that has sponsored the square, (it will stay on display for 10 seconds with message “click screen to attempt question to gain another Team Work on account, use of a Boffin is allowed, if required select any on screen. If they don’t click on screen in time , </a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" dirty="0"/></a:p><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>Action 3a)</a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>	Automatically that colour banded Company Square Dice will role and display value of 50% of question value to  player., they are credited  with this  amount to there  Game Folder. Players go ends and move passes to next player in turn. All other players will see sponsor advert whilst landing player is in play. They may use time to check their own Game Account Folder</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" dirty="0"/></a:p><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>Action 3b) </a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>If player does click in the 10 seconds. The Highlife Server will present landing player with advert of the company that has sponsored the square, (it will stay on display for 10 seconds with message “click screen to attempt question to gain another Team Worker on this Company Account  , use of a Boffins  displayed are allowed, if wanted click them now). All other players will see sponsor advert whilst landing player is in play. They may use time to check their own Game Account Folder.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" dirty="0"/></a:p><a:p><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>Action 1b</a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" dirty="0"/><a:t>)  If player selects a Boffin on screen ,on clicking screen, that colour banded Company Square Dice will role and display  reduced value of HECUs for using a selected Boffin according to terms of use for help  in answering question for player. The Boffin is removed from player after use.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" dirty="0"/></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:highlight><a:srgbClr val="FFFF00"/></a:highlight><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Action 1c)</a:t></a:r><a:r><a:rPr lang="en-GB" sz="1400" kern="1200" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Aptos" panose="020B0004020202020204" pitchFamily="34" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t> Then they will get sponsored question on screen for 20 seconds, which will be read only to them. All other players will be presented with sponsor’s advert, whilst Landing players move is active. In this time other players can choose to select to check own Game Account Folder contents.</a:t></a:r><a:endParaRPr lang="en-GB" sz="1200" dirty="0"><a:effectLst/><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:ea typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" dirty="0"/></a:p><a:p><a:endParaRPr lang="en-GB" sz="1400" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1411600074"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>